<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#007000"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    tools:context=".ManilleActivity" >

    <LinearLayout
        android:id="@+id/statusbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true" >

        <TextView
            android:id="@+id/textView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Score"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/opp_hand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_below="@+id/statusbar"
        android:orientation="horizontal" >

        <ImageView
            android:id="@+id/IVOppHand1"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVOppHand2"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVOppHand3"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVOppHand4"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVOppHand5"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVOppHand6"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVOppHand7"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVOppHand8"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

    </LinearLayout>

    <View
        android:id="@+id/view2"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_below="@id/opp_hand" />

    <LinearLayout
        android:id="@+id/opp_table"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_below="@id/view2"
        android:orientation="horizontal" >

        <ImageView
            android:id="@+id/IVOppTable1"
            android:layout_width="40dp"
            android:layout_height="51dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVOppTable2"
            android:layout_width="40dp"
            android:layout_height="51dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVOppTable3"
            android:layout_width="40dp"
            android:layout_height="51dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVOppTable4"
            android:layout_width="40dp"
            android:layout_height="51dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/play_cards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="horizontal" >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/TextView01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_weight="1"
                android:text="@string/Trumps"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <ImageView
                android:id="@+id/IVTrumps"
                android:layout_width="22dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:src="@drawable/card_blank" />
        </LinearLayout>

        <ImageView
            android:id="@+id/IVPlay1"
            android:layout_width="40dp"
            android:layout_height="51dp"
            android:layout_weight="10"
            android:src="@drawable/card_blank" />

        <View
            android:id="@+id/view3"
            android:layout_width="50dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/IVPlay2"
            android:layout_width="40dp"
            android:layout_height="51dp"
            android:layout_weight="10"
            android:src="@drawable/card_blank" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical" >

            <ImageView
                android:id="@+id/IVTurnOpp"
                android:layout_width="46dp"
                android:layout_height="16dp"
                android:layout_gravity="top"
                android:src="@drawable/uparrow" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/ToPlay"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <ImageView
                android:id="@+id/IVTurnMy"
                android:layout_width="46dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom"
                android:src="@drawable/downarrow" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/my_table"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/view1"
        android:layout_alignParentLeft="true"
        android:orientation="horizontal" >

        <ImageView
            android:id="@+id/IVMyTable1"
            android:layout_width="40dp"
            android:layout_height="51dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVMyTable2"
            android:layout_width="40dp"
            android:layout_height="51dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVMyTable3"
            android:layout_width="40dp"
            android:layout_height="51dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVMyTable4"
            android:layout_width="40dp"
            android:layout_height="51dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

    </LinearLayout>

    <View
        android:id="@+id/view1"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_above="@+id/my_hand"
        android:layout_alignParentLeft="true" />

    <LinearLayout
        android:id="@+id/my_hand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:orientation="horizontal" >

        <ImageView
            android:id="@+id/IVMyHand1"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVMyHand2"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVMyHand3"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVMyHand4"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVMyHand5"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVMyHand6"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVMyHand7"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

        <ImageView
            android:id="@+id/IVMyHand8"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:src="@drawable/card_blank" />

    </LinearLayout>

</RelativeLayout>
